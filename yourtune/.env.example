# Django environment
DJANGO_ENV=dev

# Django core
SECRET_KEY=django-insecure-change-me
ALLOWED_HOSTS=localhost,127.0.0.1


# Настройки почты  (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com


# Google OAuth2
# Получить: https://console.cloud.google.com/apis/credentials
SOCIALACCOUNT_GOOGLE_CLIENT_ID=xxx
SOCIALACCOUNT_GOOGLE_SECRET=xxx


# Yandex OAuth2
# Получить: https://oauth.yandex.ru/client/new
# Редактировать/info: https://oauth.yandex.ru/
SOCIALACCOUNT_YANDEX_CLIENT_ID=xxx
SOCIALACCOUNT_YANDEX_SECRET=xxx
# Redirect URI (На этот адрес направим пользователя после авторизации)
#http://localhost:8000/accounts/yandex/login/callback/



# Database (production / optional for dev if you switch from sqlite)
POSTGRES_DB=yourtune
POSTGRES_USER=yourtune_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432


